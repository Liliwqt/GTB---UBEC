# Godot 4+ specific ignores
.godot/
/android/

# Blender backups
*.blend1

# Export artifacts
*.apk
*.idsig
*.aab
*.x86_64
*.pck
*.wasm
Release/
build/

# Editor temporary files
*.swp

# Source / DCC directories (contain .gdignore)
**/source/

# Archive directory (legacy assets)
archive/

# Third-party vendor packs
third_party/

# Tool scripts (offline utilities, not runtime)
tools/

# Editor / IDE local settings (may contain absolute user paths)
.vscode/
.idea/

# Large DCC source maps staged for import (not runtime assets)
imports/MAP/

# Local server address override (keeps the public endpoint out of source)
server_address.cfg
server_address.local.cfg
